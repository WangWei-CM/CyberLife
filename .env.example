# Go API address. Use 127.0.0.1 behind a reverse proxy in production.
CYBERLIFE_ADDR=127.0.0.1:8080
# Keep runtime databases and uploads outside the repository in production.
CYBERLIFE_DATA_DIR=./runtime-data
# Set a unique, long administrator password before the first startup.
CYBERLIFE_ADMIN_PASSWORD=replace-with-a-long-unique-password
# false locally; true only when HTTPS terminates before the application.
CYBERLIFE_SECURE_COOKIES=false
